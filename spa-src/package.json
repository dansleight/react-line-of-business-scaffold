{
  "name": "line-of-business",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:webapi": "tsc -b && vite build --emptyOutDir --outDir ../src/Scaffold/ClientApp/dist",
    "build:fastapi": "tsc -b && vite build --emptyOutDir --outDir=../python-src/client_app --base=/static/",
    "build:validate": "tsc -b && vite build && rimraf --glob ./*.tsbuildinfo && rimraf --glob ./dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "update": "npm-check-updates --target minor -u && pnpm i && pnpm update",
    "generate-api": "node generate-api.js",
    "set-logo": "pnpm dlx tsx set-logo.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@azure/msal-react": "^5.7.2",
    "@fortawesome/fontawesome-common-types": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@metismenu/react": "^0.0.3",
    "bootstrap": "^5.3.8",
    "bootswatch": "^5.3.8",
    "classnames": "^2.5.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "simplebar-react": "^3.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "inquirer": "^12.11.1",
    "npm-check-updates": "^19.6.6",
    "openapi-types": "^12.1.3",
    "rimraf": "^6.1.3",
    "sass": "^1.105.1",
    "swagger-typescript-api": "13.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=18",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.30.0",
      "onFail": "error"
    }
  },
  "prettier": {
    "overrides": [
      {
        "files": "routes.tsx",
        "options": {
          "printWidth": 200,
          "arrowParens": "avoid"
        }
      }
    ]
  }
}
