{
  "ApplicationMode": "#{ApplicationMode}#",
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "#tenantid#",
    "ClientId": "#clientid#",
    "ClientSecret": "#clientsecret#",
    "WebApiScope": "#scope#"
  },
  "DownstreamApi": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": [ "User.Read" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "#DefaultConnection#"
  },
  "RoleMappings": [
    {
      "Role": "Admin",
      "Groups": ["Admins"]
    }
  ],
  "MemoryCache": {
    "DefaultSlidingTimespanMinutes": 15,
    "DefaultAbsoluteTimespanMinutes": 60,
    "SemaphoreWaitTimeoutSeconds": 5,
    "DefaultCachingRecordLimit": 1000
  },
  "ReleaseInformation": {
    "BuildNumber": "#{BuildNumber}#"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.ClientInfo",
      "Serilog.Exceptions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{Username}] {Message:lj}{NewLine}{Exception}"
        }
      },
      "SqlServerSink": {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "dat_SerilogLogs",
            "schemaName": "dbo",
            "autoCreateSqlTable": false,
            "batchPostingLimit": 1000,
            "batchPeriod": "0.00:00:05"
          },
          "restrictedToMinimumLevel": "Information",
          "columnOptionsSection": {
            "addStandardColumns": ["LogEvent"],
            "removeStandardColumns": ["Properties"],
            "additionalColumns": [
              {
                "ColumnName": "Username",
                "DataType": "nvarchar",
                "AllowNull": true,
                "DataLength": 100
              },
              {
                "ColumnName": "MachineName",
                "DataType": "nvarchar",
                "AllowNull": true,
                "DataLength": 50
              },
              {
                "ColumnName": "ApplicationName",
                "DataType": "nvarchar",
                "AllowNull": true,
                "DataLength": 50
              }
            ],
            "logEvent": {
              "excludeStandardColumns": true
            }
          }
        }
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithEnvironmentUserName",
      "WithClientIp",
      {
        "Name": "WithCorrelationId",
        "Args": {
          "headerName": "x-correlation-id",
          "addValueIfHeaderAbsence": true
        }
      },
      {
        "Name": "WithRequestHeader",
        "Args": {
          "headerName": "User-Agent"
        }
      },
      "WithExceptionDetails"
    ],
    "Properties": {
      "ApplicationMode": "#{ApplicationMode}",
      "ApplicationName": "Scaffold"
    }
  },
  "AllowedHosts": "*"
}
