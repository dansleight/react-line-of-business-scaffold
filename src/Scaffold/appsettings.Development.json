{
  "ApplicationMode": "Development",
  "EntraId": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "ClientSecret": "",
    "WebApiScope": ""
  },
  "DownstreamApi": {
    "BaseUrl": "https://graph.microsoft.com/v1.0",
    "Scopes": [ "User.Read" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Initial Catalog=Scaff_DB;User Id=user_Scaff_DB;Password=Password!here;Encrypt=Yes;TrustServerCertificate=Yes;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      "ConsoleSink": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss} [{Level:u3}] [{Username}] {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  }
}
