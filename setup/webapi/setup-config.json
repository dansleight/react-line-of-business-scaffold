{
  "name": "WebAPI (C# .NET)",
  "steps": [
    {
      "action": "remove",
      "files": ["./assets/DbScripts/SqlServer/2 - FastAPI logs.sql"]
    },
    {
      "action": "replace-text",
      "target": [
        "./assets/DbScripts/SqlServer/1 - Init.sql",
        "./assets/DbScripts/SqlServer/2 - WebAPI logs.sql",
        "./assets/DbScripts/SqlServer/3 - DB User.sql",
        "./src/Scaffold/appsettings.Development.json",
        "./src/**/*.md"
      ],
      "match": "Scaff_DB",
      "to": "${dbName}",
      "comment": "Replace the sample database name, including copied markdown"
    },
    {
      "action": "replace-text",
      "target": "./spa-src/src/appConfig.ts",
      "match": "User.ReadWrite",
      "to": "User.Read",
      "comment": "Downgrade MS Graph permission"
    },
    {
      "action": "replace-text",
      "target": [
        "./spa-src/.env",
        "./spa-src/src/appConfig.ts",
        "./spa-src/vite.config.ts",
        "./src/.vscode/launch.json",
        "./src/Scaffold/Properties/launchSettings.json",
        "./src/**/*.md",
        "./spa-src/**/*.md"
      ],
      "match": "5011",
      "to": "${apiPort}",
      "comment": "Set dynamic API port"
    },
    {
      "action": "replace-text",
      "target": [
        "./src/.vscode/launch.json",
        "./src/.vscode/tasks.json",
        "./src/.vscode/settings.json",
        "./spa-src/.vscode/settings.json"
      ],
      "match": "Scaffold",
      "to": "${ns}",
      "comment": "Replace 'Scaffold' with namespace in multiple files"
    },
    {
      "action": "replace-text",
      "target": "./spa-src/package.json",
      "match": "line-of-business",
      "to": "${nslower}",
      "comment": "Replace 'line-of-business' witn namespace in package.json"
    },
    {
      "action": "replace-text",
      "target": ["./spa-src/vite.config.ts", "./spa-src/src/appConfig.ts"],
      "match": "3011",
      "to": "${spaPort}",
      "comment": "Replace port in vite.config.ts"
    },
    {
      "action": "replace-text",
      "target": "./spa-src/src/layouts/variable/sidebar/Sidebar.tsx",
      "match": "Scaff <sup>00</sup>",
      "to": "${title}",
      "comment": "Title on Sidebar"
    },
    {
      "action": "remove-scripts",
      "target": "./spa-src/package.json",
      "scripts": ["build:fastapi"],
      "comment": "Safely remove Python-related npm scripts"
    },
    {
      "action": "replace-text",
      "target": "./spa-src/package.json",
      "match": "build:webapi",
      "to": "build:release",
      "comment": "renaming the build script"
    },
    {
      "action": "replace-text",
      "target": "./spa-src/README.md",
      "match": "Production builds: `pnpm build:webapi` (output under `src/Scaffold/ClientApp/dist`) or `pnpm build:fastapi`.",
      "to": "Production builds: `pnpm build:release` (output under `src/${ns}/ClientApp/dist`).",
      "comment": "Point the SPA readme at the renamed production script"
    },
    {
      "action": "replace-text",
      "target": ["./src/**/*.md", "./spa-src/**/*.md", "./assets/generator/**/*.md"],
      "match": "\\bScaffold\\b",
      "regex": true,
      "to": "${ns}",
      "comment": "Project name in the docs setup copies"
    }
  ]
}
